# Staging configuration for deploy/compose.staging.yml.
#
# Copy this file to deploy/.env.staging ON THE STAGING SERVER and replace every
# CHANGE_ME with a real value. deploy/.env.staging is gitignored and must never
# be committed. See .env.example (repo root) for the full explanation of every
# key — only the staging-specific notes are repeated here.
#
# APP_ENV=staging turns on hard boot checks: config.RequireSecretsOutsideDev
# (Stripe/Xendit/Supabase webhook secrets, XENDIT_ALLOWED_CIDRS, STATS_TOKEN, a
# non-placeholder WEBHOOK_SECRET_ENCRYPTION_KEY) and config.RequireGeoIPDBOutsideDev
# (GEOIP_DB_PATH must point at a real file). The stack will not start until they pass.

# --- App ---------------------------------------------------------------------
APP_ENV=staging
PORT=8080
APP_URL=https://staging.example.com
SERVICE_NAME=stratum
SERVICE_VERSION=staging
# Comma-separated allowed origins. REQUIRED outside development — the CORS
# middleware refuses to start on an empty value when APP_ENV != development.
CORS_ORIGINS=https://staging.example.com
AUDIT_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=30

# CIDR ranges of whatever terminates TLS in front of this stack (comma-separated).
# Prefilled with Cloudflare's edge ranges as in .env.example; replace if staging
# sits behind something else, or set empty if the api port is directly exposed.
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# Path INSIDE the container. compose.staging.yml bind-mounts
# ./secrets/GeoLite2-Country.mmdb here; put your MaxMind-licensed copy at
# deploy/secrets/GeoLite2-Country.mmdb on the server (gitignored, never redistribute).
GEOIP_DB_PATH=/data/GeoLite2-Country.mmdb

# Gates GET /health/stats. Required outside development.
STATS_TOKEN=CHANGE_ME

# --- Postgres --------------------------------------------------------------------
# Host is the compose service name. The migrate service uses the owner role
# (POSTGRES_URL / DATABASE_URL); the app/worker/webhook roles are created by
# deploy/postgres-init/01-app-role.sql on the postgres container's first boot,
# with the passwords below. Regenerate all of them for a real staging box and
# update 01-app-role.sql to match.
POSTGRES_URL=postgres://stratum:stratum@postgres:5432/stratum?sslmode=disable
DATABASE_URL=postgres://stratum:stratum@postgres:5432/stratum?sslmode=disable
POSTGRES_APP_URL=postgres://stratum_app:stratum_app@postgres:5432/stratum?sslmode=disable
POSTGRES_WORKER_URL=postgres://stratum_worker:stratum_worker@postgres:5432/stratum?sslmode=disable
POSTGRES_WEBHOOK_URL=postgres://stratum_webhook:stratum_webhook@postgres:5432/stratum?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_BACKGROUND_MAX_OPEN_CONNS=5
POSTGRES_MAX_IDLE_TIME=5m
# Per-connection statement_timeout; "0" disables. Default is 30s.
POSTGRES_STATEMENT_TIMEOUT=30s

# --- Redis / RabbitMQ ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://stratum:stratum@rabbitmq:5672/

# --- Auth (Supabase) ---------------------------------------------------------
AUTH_JWKS_URL=https://CHANGE_ME.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://CHANGE_ME.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_ADMIN_URL=https://CHANGE_ME.supabase.co/auth/v1
AUTH_SERVICE_ROLE_KEY=CHANGE_ME
AUTH_ACCESS_TOKEN_MAX_TTL=1h
SUPABASE_WEBHOOK_SECRET=CHANGE_ME

# Encrypts organization webhook endpoint secrets at rest. Required in every
# environment. Generate: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=CHANGE_ME

# Object storage for avatars etc. Empty disables the feature.
STORAGE_URL=

# --- Logging / telemetry -----------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_COLLECTOR_URL=

# --- Stripe (USD) ----------------------------------------------------------------
STRIPE_API_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_SUCCESS_URL=https://staging.example.com/billing/success
STRIPE_CANCEL_URL=https://staging.example.com/billing/cancel

# --- Xendit (IDR) --------------------------------------------------------------
XENDIT_API_KEY=CHANGE_ME
XENDIT_CALLBACK_TOKEN=CHANGE_ME
# Xendit's published webhook-source CIDRs, comma-separated. Required outside development.
XENDIT_ALLOWED_CIDRS=CHANGE_ME

# --- SMTP --------------------------------------------------------------------
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=Stratum
