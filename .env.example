# App
APP_ENV=development
PORT=8000
APP_URL=http://localhost:3000
SERVICE_NAME=stratum
SERVICE_VERSION=v0.3.0

# Audit log retention (days)
AUDIT_RETENTION_DAYS=30

# CORS — comma-separated origins, empty = allow all (development)
CORS_ORIGINS=

# CIDR ranges of any reverse proxy/load balancer/ingress this service sits
# directly behind (comma-separated). Empty = trust nobody, so Context.ClientIP()
# (IP allowlists, per-IP rate limiting, and GeoIP billing-country resolution —
# see GEOIP_DB_PATH below) reads the raw TCP peer address — correct only if
# this process is directly internet-facing. Set this to whatever terminates
# connections in front of it (e.g. an ingress controller's pod CIDR) in any
# other topology, or every forwarded request — and every GeoIP lookup done on
# it — resolves to the proxy's own IP/location instead of the real client's.
#
# Prefilled below with Cloudflare's own published edge ranges
# (https://www.cloudflare.com/ips-v4, ips-v6) since production/staging sit behind
# Cloudflare (orange-cloud DNS). Harmless in local dev even though nothing there
# is actually behind Cloudflare: ClientIP() only trusts forwarded headers from a
# peer whose IP is in this list, and localhost never is, so it silently falls
# back to the raw TCP peer same as if this were empty. Cloudflare rarely changes
# this list but does occasionally — re-pull both URLs if IP-based features
# start misbehaving.
TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32

# Path to a MaxMind GeoLite2/GeoIP2 Country .mmdb file — the trusted source
# for an organization's billing country/currency at creation (POST
# /organizations) and for GET /references/plans|addons' currency scoping,
# both resolved from the caller's real IP via internal/platform/geoip
# instead of any client-supplied field (closed 2026-08-06 — a client
# declaring its own billing country/currency was a real price-arbitrage
# hole). Required outside development (config.RequireGeoIPDBOutsideDev fails
# startup if unset) — get a free MaxMind account + license key at
# maxmind.com, then use their `geoipupdate` tool to fetch/refresh
# GeoLite2-Country.mmdb (MaxMind's terms discourage running on a stale
# copy; geoipupdate handles that). Empty is fine in development:
# geoip.Resolver falls back to the X-Debug-Country-Code request header
# instead (never honored outside development), so you can simulate any
# country locally without a real database file.
#
# Convention for this repo: drop the file at the project root
# (./GeoLite2-Country.mmdb, gitignored — never redistribute MaxMind's
# database by committing it) and point this at that path. Left empty
# below rather than pre-filled with that path, deliberately: geoip.New
# errors on startup if GEOIP_DB_PATH is non-empty but the file doesn't
# exist yet, so a pre-filled default would break `go run ./cmd/api` for
# anyone who hasn't downloaded the file yet. Uncomment once you have it:
# GEOIP_DB_PATH=./GeoLite2-Country.mmdb
GEOIP_DB_PATH=

# Gates GET /health/stats (goroutine/heap/pool internals) — empty = unauthenticated.
# Set outside development and register the same value on the project in Studio
# so its poller can send it back as X-Stats-Token.
STATS_TOKEN=

# Postgres (required)
# owner role used for migrations/tests
POSTGRES_URL=postgres://stratum:stratum@localhost:5432/stratum?sslmode=disable

# app role used by cmd/api
POSTGRES_APP_URL=postgres://stratum_app:stratum_app@localhost:5432/stratum?sslmode=disable

# worker role used by cmd/worker
POSTGRES_WORKER_URL=postgres://stratum_worker:stratum_worker@localhost:5432/stratum?sslmode=disable

# webhook role used by cmd/api's Stripe/Xendit webhook handlers only.
# cmd/worker also requires this var set even though it never opens a pool
# with it — both binaries load the same PostgresConfig struct.
POSTGRES_WEBHOOK_URL=postgres://stratum_webhook:stratum_webhook@localhost:5432/stratum?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
# Size of Infra.BackgroundPool (cmd/api only) — isolates background writes (audit log flush, last_seen_at update) from request-path connection contention
POSTGRES_BACKGROUND_MAX_OPEN_CONNS=5
POSTGRES_MAX_IDLE_TIME=5m

# Redis (required)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (required)
RABBITMQ_URL=amqp://stratum:stratum@localhost:5672/

# Auth — Supabase (required)
AUTH_JWKS_URL=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://<your-project>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_ADMIN_URL=https://<your-project>.supabase.co/auth/v1
AUTH_SERVICE_ROLE_KEY=

# Shared secret header for Supabase's Database Webhook on auth.users (UPDATE)
# — Dashboard → Database → Webhooks → custom header "X-Webhook-Secret".
# Syncs account.users.email after Supabase's own Secure Email Change confirms.
SUPABASE_WEBHOOK_SECRET=

# Encrypts organization webhook endpoint secrets at rest (pgcrypto pgp_sym_encrypt/
# pgp_sym_decrypt on the secret_encrypted/secret_encrypted_previous columns).
# Required in every environment, including local dev — there is no skip-encryption
# mode; config.Load() fails startup if this is unset. Generate a fresh value with:
# openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

STORAGE_URL=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# OpenTelemetry — leave empty to disable
OTEL_COLLECTOR_URL=

# Stripe (USD payments)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://app.example.com/billing/success
STRIPE_CANCEL_URL=https://app.example.com/billing/cancel

# Xendit (IDR payments)
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
# Xendit's published webhook-source CIDR ranges (comma-separated) — required
# outside development. Only effective once TRUSTED_PROXIES above correctly
# reflects whatever sits in front of this service, if anything does.
XENDIT_ALLOWED_CIDRS=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Stratum
