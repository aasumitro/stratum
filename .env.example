# App
APP_ENV=development
PORT=8000
APP_URL=http://localhost:3000
SERVICE_NAME=stratum
SERVICE_VERSION=v0.2.0

# Audit log retention (days)
AUDIT_RETENTION_DAYS=30

# CORS — comma-separated origins, empty = allow all (development)
CORS_ORIGINS=

# CIDR ranges of any reverse proxy/load balancer/ingress this service sits
# directly behind (comma-separated). Empty = trust nobody, so Context.ClientIP()
# (IP allowlists, per-IP rate limiting) reads the raw TCP peer address — correct
# only if this process is directly internet-facing. Set this to whatever
# terminates connections in front of it (e.g. an ingress controller's pod CIDR)
# in any other topology, or every forwarded request will resolve to the proxy's
# own IP instead of the real client's.
TRUSTED_PROXIES=

# Gates GET /health/stats (goroutine/heap/pool internals) — empty = unauthenticated.
# Set outside development and register the same value on the project in Studio
# so its poller can send it back as X-Stats-Token.
STATS_TOKEN=

# Postgres (required)
POSTGRES_URL=postgres://stratum:stratum@localhost:5432/stratum?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_TIME=5m

# Redis (required)
REDIS_URL=redis://localhost:6379/0

# RabbitMQ (required)
RABBITMQ_URL=amqp://stratum:stratum@localhost:5672/

# Auth — Supabase (required)
AUTH_JWKS_URL=https://<your-project>.supabase.co/auth/v1/.well-known/jwks.json
AUTH_ISSUER=https://<your-project>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_ADMIN_URL=https://<your-project>.supabase.co/auth/v1
AUTH_SERVICE_ROLE_KEY=

# Shared secret header for Supabase's Database Webhook on auth.users (UPDATE)
# — Dashboard → Database → Webhooks → custom header "X-Webhook-Secret".
# Syncs account.users.email after Supabase's own Secure Email Change confirms.
SUPABASE_WEBHOOK_SECRET=

STORAGE_URL=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# OpenTelemetry — leave empty to disable
OTEL_COLLECTOR_URL=

# Stripe (USD payments)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://app.example.com/billing/success
STRIPE_CANCEL_URL=https://app.example.com/billing/cancel

# Xendit (IDR payments)
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
# Xendit's published webhook-source CIDR ranges (comma-separated) — required
# outside development. Only effective once TRUSTED_PROXIES above correctly
# reflects whatever sits in front of this service, if anything does.
XENDIT_ALLOWED_CIDRS=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Stratum
